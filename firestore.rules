rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Allow read access to everyone
      allow read: if true;
      // Allow write access only to the specific admin email
      allow write: if request.auth != null && request.auth.token.email == "jasmine.kuo@neurobraindynamics.com";
    }
  }
}
